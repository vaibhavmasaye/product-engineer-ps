# Webhook Retry Engine Environment Configuration

# Service HTTP port
PORT=8000

# Destination webhook URL
WEBHOOK_URL=http://localhost:3001/webhook

# SQLite Database storage path (use :memory: for in-memory)
DATABASE_PATH=./data/engine.db

# Retry policy configuration
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_DELAY_MS=5000
RETRY_MAX_DELAY_MS=300000
RETRY_JITTER_PERCENT=0.1

# Worker polling interval (ms)
WORKER_POLL_INTERVAL_MS=1000

# Demo test receiver port
RECEIVER_PORT=3001

